","recordContentSource":{"@authority":"marcorg","#text":"MiAaPQ"},"recordCreationDate":{"@encoding":"marc","#text":"070718"},"recordChangeDate":{"@encoding":"iso8601","#text":"20240227"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99161629417003941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"@version":"3.8","titleInfo":{"nonSort":{"@space":"preserve","#text":"A  "},"title":"love letter to Africville "},"name":{"@usage":"primary","@type":"personal","namePart":["Carvery-Taylor, Amanda,",{"@type":"date","#text":"1980-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PCjvQTvh6DbBC3wdV6Ry8G3"},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"Medical Subject Headings","#text":"Anecdotes"},{"@authority":"Medical Subject Headings","#text":"Portrait"},{"@authority":"aat","#text":"portraits."},{"@authority":"fast","#text":"Anecdotes"},{"@authority":"fast","#text":"Biographies"},{"@authority":"fast","#text":"Portraits"},{"@authority":"lcgft","#text":"Anecdotes."},{"@authority":"lcgft","#text":"Portraits"},{"@authority":"rvmgf","#text":"Anecdotes."},{"@authority":"rvmgf","#text":"Portraits."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nsc"},{"@type":"text","@authority":"marccountry","#text":"Nova Scotia"}]},"dateIssued":{"@encoding":"marc","#text":"2021"},"issuance":"monographic"},{"@eventType":"publication","place":[{"placeTerm":{"@type":"text","#text":"Halifax ;"}},{"placeTerm":{"@type":"text","#text":"Winnipeg :"}}],"agent":[{"namePart":"Roseway Publishing, an imprint of Fernwood Publishing,","role":{"roleTerm":"publisher"}},{"namePart":"Roseway Publishing, an imprint of Fernwood Publishing,","role":{"roleTerm":"publisher"}}],"dateIssued":[2021]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"95 pages : illustrations, portraits (chiefly black and white) ; 26 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"portrait"}},{"form":{"@type":"Color content","#text":"monochrome"}}],"abstract":{"@type":"Summary","#text":"\"The Africville Community is aging, and there is a great need to document the people and the history. There are many books with historical information on Africville, and there are also fiction and children's books about Africville. There is great need for the personal stories and photos of the remaining Africville Community to be gathered and organized and shared. My intentions would be to meet with Elders who have lived in Africville for a formal portrait session. I would then ask them to share a favourite memory, story, or information they want shared. The key is to focus on the positive things the community offered. These will be stories about happy things that people did as children, or how the community came together to overcome difficulties. The focus would be the love that existed in Africville. During the session(s) I would also like to capture candid photos of the storyteller so that the reader can get a feel for the emotional connection to the stories being told.\"-- Provided by publisher."},"note":{"@type":"statement of responsibility","#text":"Amanda Carvery-Taylor."},"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-cn-ns"}},{"@authority":"lcsh","topic":"Older people","geographic":["Nova Scotia","Halifax"],"genre":"Anecdotes"},{"@autho