# ---------- Black History Discovery Hub — environment ----------
# Copy to .env (project root). The backend reads this file; the frontend only needs API_URL.

# Database (embedded Postgres from `make db` by default; any Postgres 16 + pgvector works)
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/bhdh
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/bhdh_test
PG_PORT=54329
# PGDATA_DIR=backend/.pgdata

# AI guide + shelf vision. PRD default is OpenAI (Responses API). "auto" = openai if OPENAI_API_KEY, else anthropic, else none.
LLM_PROVIDER=auto
OPENAI_API_KEY=                 # https://platform.openai.com/api-keys
OPENAI_MODEL=gpt-6.1-terra
OPENAI_VISION_MODEL=gpt-6.1-terra
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
ANTHROPIC_API_KEY=              # https://console.anthropic.com/  (used now: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Embeddings: local = fastembed BAAI/bge-small-en-v1.5 (no key, ~130 MB download on first run); openai = text-embedding-3-small
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional connectors (connectors show "unconfigured" on /about/sources until set)
DPLA_API_KEY=                   # free: curl -X POST https://api.dp.la/v2/api_key/<your-email>  (key arrives by email)
EUROPEANA_API_KEY=              # free: https://www.europeana.eu/en/how-to-register-for-and-manage-an-api-key
SMITHSONIAN_API_KEY=            # free api.data.gov key (instant, by email): https://api.data.gov/signup/  — unlocks Smithsonian Open Access incl. NMAAHC
NYPL_API_TOKEN=                 # free (instant, by email): https://api.repo.nypl.org/sign_up  — unlocks NYPL Digital Collections incl. the Schomburg Center
# Keyless connectors need nothing: Library of Congress SRU, Internet Archive, Dalhousie Archives OAI-PMH, UK National Archives Discovery, Wikimedia Commons, Harvard LibraryCloud, Nova Scotia Open Data.

# Outbound HTTP etiquette
HTTP_USER_AGENT=BlackHistoryDiscoveryHub/0.1 (hackathon prototype)
HTTP_CACHE_TTL_SECONDS=604800

# Auth (partner portal). Change JWT_SECRET for anything beyond local demos.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
COOKIE_SECURE=false

# Jobs: true = run shelf-scan jobs inline in the API process; false = run `make worker`
JOBS_INLINE=true
UPLOAD_DIR=backend/uploads
CORS_ORIGINS=http://localhost:3000

# Seed
SEED_PASSWORD=hub-demo-2026
SEED_MAX_PER_QUERY=40

# Frontend (frontend/.env.local or shell): where Next.js proxies /api/* to
API_URL=http://127.0.0.1:8000

# Dalhousie University Archives OAI-PMH (keyless): fonds-level descriptions read per harvest, and pages (100 records) read per matching fonds
DAL_OAI_MAX_SETS=700
DAL_OAI_MAX_PAGES_PER_SET=3

# Retrieval quality (keyless). RERANKER=local uses a small fastembed cross-encoder (~90 MB download on first use) to reorder the top candidates; none = fused order only.
RERANKER=local
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Guide answers are cached in memory per (question, filters, previous turn) for this many seconds; 0 disables.
GUIDE_CACHE_TTL_SECONDS=600
